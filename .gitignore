# Linked git worktrees live here (git worktree add). A worktree is a full checkout, so
# `git add -A` from the main tree would otherwise stage an entire second copy of the repo.
.worktrees/

# Editor/tooling index. Rebuilt on demand, never a source of truth, and it is per-machine.
.dsh-code-index/

# Evidence
evidence/

# Zero Council runtime artifacts - never commit
.zc-*.json
.zc-tmp/
node_modules/
# Scratch artifacts - never commit
# Windows reserved device name created by accidental `> nul` redirects in non-cmd shells
nul
**/nul
commit-msg*.txt
*.log
.zc*-out.txt

# Verify-driver output (screenshots + JSON traces). Directory is kept for the drivers.
.agent/evidence/*
!.agent/evidence/.gitkeep
