# -----------------------------------------------------------------------------
# Zero Council — Environment Configuration Template
# Copy to `web/.env.local` (git-ignored) for local setup.
# In production, configure these in Vercel -> Project Settings -> Environment Variables
# (or push via `.github/workflows/sync-vercel-env.yml`).
# Never commit real credentials or secrets to version control.
# -----------------------------------------------------------------------------

# Canonical public origin used for metadata, sitemap, CSRF checks, OAuth redirects, and PayOS return URLs.
NEXT_PUBLIC_SITE_URL=https://zerocouncil.app

# -----------------------------------------------------------------------------
# Supabase (Authentication & Persistent Store)
# Apply all migrations under `web/supabase/migrations/` (0001 -> 0010) before production traffic.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_replace_me

# Server-only Supabase credentials (bypasses RLS; NEVER expose via NEXT_PUBLIC_*)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_service_role_replace_me

# -----------------------------------------------------------------------------
# Provider Key Encryption (Required in Production / Vercel)
# AES-256-GCM secret for stored BYOK provider keys: base64 of 32 random bytes.
# Generate via:
#   openssl rand -base64 32
# or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# When VERCEL=1 or ZC_REQUIRE_PROD_SECRETS=1, missing/invalid values fail closed.
# -----------------------------------------------------------------------------
ZC_PROVIDER_KEY_SECRET=

# Optional: force production-grade secret enforcement outside Vercel (0 or 1).
# ZC_REQUIRE_PROD_SECRETS=1

# -----------------------------------------------------------------------------
# payOS Merchant Channel — https://my.payos.vn (Server-only; NEVER use NEXT_PUBLIC_PAYOS_*)
# All three keys are required in production; without them checkout returns 503.
# Legacy `PAYLOS_*` variable names remain supported only as server-side fallback aliases.
# -----------------------------------------------------------------------------
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# -----------------------------------------------------------------------------
# Founder / Supreme Admin Accounts (Optional, Server-only)
# Comma-separated list of founder emails permitted to demote admins and reset passwords.
# Defaults to the built-in project founder email when left blank.
# -----------------------------------------------------------------------------
FOUNDER_EMAILS=

# -----------------------------------------------------------------------------
# Analytics — Umami (Optional, consent-gated, page-view counting only)
# Leave `NEXT_PUBLIC_ANALYTICS_WEBSITE_ID` blank to disable analytics script loading completely.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_ANALYTICS_HOST_URL=https://cloud.umami.is

# -----------------------------------------------------------------------------
# Local Development & Automated Testing Only (NEVER set on Vercel / Production)
# -----------------------------------------------------------------------------
# ZC_DEV_LOGIN_EMAIL=dev@zerocouncil.local
# ZC_DISABLE_RATE_LIMIT=0
# ZC_ORDER_STORE=
