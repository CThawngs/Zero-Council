# payOS merchant channel — https://my.payos.vn
# Copy to `.env.local` (git-ignored). All three are required; without them the checkout
# button answers 503 PAYLOS_NOT_CONFIGURED instead of failing silently.
#
# In production these belong in the host's environment (Vercel → Project Settings →
# Environment Variables), not in a file. Deleting this folder then costs nothing.
PAYLOS_CLIENT_ID=
PAYLOS_API_KEY=
PAYLOS_CHECKSUM_KEY=

# Order store — Supabase. Set BOTH and the order table is read/written over PostgREST;
# with them unset, local development falls back to the JSON file below.
#
# In production a missing database is refused outright rather than falling back to a file,
# because a deployed instance that silently writes to a local filesystem loses orders and
# confirms no payments.
#
# Apply the table first: web/supabase/migrations/0001_zc_orders.sql (Supabase CLI, the
# dashboard SQL Editor, or the Management API — DDL cannot be run through PostgREST).
SUPABASE_URL=
# Service role: server only, bypasses RLS, never reachable from a client component.
# The `sbp_` access token is a different credential and is not used here.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. `CODE=AMOUNT_VND` pairs, comma separated. Unset = every code rejected.
# PAYOS_DISCOUNT_CODES=WELCOME=10000,PARTNER=25000

# Optional. Only consulted when Supabase is unset. Development-only: the path payOS
# orders are written to. Defaults to `<cwd>/.zc-orders.json`.
# ZC_ORDER_STORE=

# Analytics — optional. Page-view counting only, nothing more.
#
# Leave BOTH blank and the site loads no analytics at all: no request is made and the consent
# dialog still appears, it just has nothing behind it. This is the safe default for local work.
#
# All three are PUBLIC (`NEXT_PUBLIC_`): they ship in the browser bundle, so this must never be
# used for a secret. Umami's own API keys stay in the Umami dashboard and are never pasted here.
#
# Values below are Umami Cloud. A self-hosted instance just changes SCRIPT_URL and HOST_URL.
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
NEXT_PUBLIC_ANALYTICS_HOST_URL=https://cloud.umami.is

# The script is not fetched until the visitor presses "Allow analytics". Rejecting, or closing
# the dialog without choosing, leaves it unloaded — see `web/src/prototype/components/CookieNotice.tsx`.
